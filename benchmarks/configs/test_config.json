    "class_balance_mutation": true,
    "mutation_factor": 0.5,
    "uniform_crossover": false,
    "patience": 5,
    "early_stop": 100,
    "sampling_start": 0,
    "mutation_size_neighborhood": 10,
    "mutation_percentage_change": 0.1,
    "flaml_ms": false,
    "search_space_config": "classification_models_all.json"

