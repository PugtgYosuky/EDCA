{
    "openml_splits": false,
    "task": "classification",
    "train_dataset": "MedViT2-nopt/all_data/retrospective/retrospective_femur_head_abdomen_emb_plus_raw_features.csv",
    "test_dataset": "MedViT2-nopt/all_data/prospective/prospective_femur_head_abdomen_emb_plus_raw_features.csv",
    "label_col": "Class",
    "drop_cols": ["Processo"],
    "save_path": "MedViT2-nopt/3planes_raw_features/exp4",
    "kfold": 5,
    "run-fold": null,
    "run_all_seeds": true,    
